+        pub fn reset_drained(self: *Self) error{BodyStateBusy}!void {
+            if (!self.is_drained()) return error.BodyStateBusy;
+            for (&self.slots) |*slot| {
+                const generation = slot.body.generation;
+                const owner = slot.owner;
+                const index = slot.index;
+                slot.* = .{ .owner = owner, .index = index, .body = .{ .generation = generation } };
+            }
+        }
