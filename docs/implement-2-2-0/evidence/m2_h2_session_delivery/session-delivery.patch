+        try fixture.head(1, null, false, false);
+        try fixture.frame(.data, 0, 1, "abc");
+        if (blocked) try fixture.fill_output(0);
+        try fixture.frame(.data, 0, 1, "d");
+        try std.testing.expectEqual(@as(usize, 1), fixture.bindings[0].cancels);
+        try std.testing.expectEqual(@as(u16, 0), fixture.router.body.active[0]);
+        try std.testing.expect(!fixture.control_failure);
+        if (blocked) {
+            try std.testing.expectEqual(@as(usize, 0), fixture.session.pending_reset_count);
