diff --git a/src/tests/http2_upload_driver_tests.zig b/src/tests/http2_upload_driver_tests.zig
new file mode 100644
--- /dev/null
+++ b/src/tests/http2_upload_driver_tests.zig
@@ -0,0 +1,985 @@
+const std = @import("std");
+const support = @import("test_support");
+const server = support.http2_server;
+const wire = support.http2;
+const body = support.request_body;
+const admission = support.body_admission;
+const radix = support.radix;
+const Request = support.http_request.Request;
+const Response = support.http_response.Response;
+const StreamingRequest = support.streaming_request.StreamingRequest;
+const Session = server.server_session(4);
+const Driver = support.http2_upload.upload_driver(4);
+const capacities = Session.Capacities{ .stream_request_bodies = true, .body_size = 16, .request_header_size = 4096 };
+const RouterBundle = radix.Bundle(.{ .stream_request_bodies = true, .max_route_params = 20 });
+const ResetDuring = enum { none, begin, chunk, end, admission, cancel };
+const BufferedAction = enum { none, reset_error, response_error };
+
+const Binding = struct {
+    fixture: *Fixture,
+    control: body.BodyControl,
+    stream_id: u32,
+    bytes: [4096]u8 = undefined,
+    length: usize = 0,
+    chunks: usize = 0,
+    ends: usize = 0,
+    cancels: usize = 0,
+    reason: ?body.BodyCancelReason = null,
+};
+
+const Fixture = struct {
+    bundle: Session.Bundle(capacities) = .{},
+    session: Session = .{},
+    driver: Driver = undefined,
+    router_bundle: RouterBundle = .{},
+    router: radix.Router = .{},
+    definition: body.BodyRoute = undefined,
+    captures_names: [16][]const u8 = undefined,
+    captures_values: [16][]const u8 = undefined,
+    bindings: [4]Binding = undefined,
+    output: [4080]u8 = undefined,
+    output_length: usize = 0,
+    begins: usize = 0,
+    middleware_calls: usize = 0,
+    buffered_calls: usize = 0,
+    pause_begin: bool = false,
+    pause_prefix: ?usize = null,
+    fail_begin: bool = false,
+    fail_chunk: bool = false,
+    fail_end: bool = false,
+    reset_during: ResetDuring = .none,
+    control_failure: bool = false,
+    metadata_ok: bool = true,
+    legacy: bool = false,
+    legacy_refusal: bool = false,
+    buffered_bytes: usize = 0,
+    expected_active_in_end: u16 = 1,
+    closed_calls: usize = 0,
+    buffered_action: BufferedAction = .none,
+
+    fn init(self: *Fixture) !void {
+        self.session = try Session.init(self.bundle.storage());
+        try self.session.reset();
+        self.router = try radix.Router.init(self.router_bundle.storage());
+        self.definition = .{ .sink = .{ .context = self, .begin = begin, .chunk = chunk, .end = end, .cancel = cancel }, .limits = .{ .max_body_bytes = 4096, .max_active = 4 }, .middleware_policy = .headers_only };
+        try self.router.route_body(.post, "/upload/:name", &self.definition);
+        self.driver = .{ .session = &self.session, .context = self, .admission_target = .{ .context = self, .router = &self.router, .resolve = resolve }, .capture_names = &self.captures_names, .capture_values = &self.captures_values };
+        self.driver.bind();
+        try self.session.receive(wire.client_preface, self.callbacks());
+        try self.frame(.settings, 0, 0, "");
+        self.output_length = 0;
+    }
+
+    fn callbacks(self: *Fixture) server.Callbacks {
+        return .{ .context = self, .write_fn = write, .request_fn = buffered, .stream_closed_fn = closed, .header_fn = if (self.legacy) legacy_header else null, .body_select_fn = if (self.legacy) null else selects, .body_event_fn = if (self.legacy) null else event };
+    }
+    fn selects(context: *anyopaque, request: *const Request) bool {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        return self.driver.selects(request);
+    }
+    fn resolve(context: *anyopaque, input: *const admission.Input, response: *Response) admission.Decision {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        if (self.reset_during == .admission) {
+            self.session.reset_stream(self.session.connection.streams.stream_ids[0], .cancel, self.callbacks()) catch {
+                self.control_failure = true;
+            };
+            self.metadata_ok = self.metadata_ok and std.mem.startsWith(u8, input.request.path, "/upload/");
+        }
+        return admission.resolve_router(&self.router, input, response);
+    }
+    fn event(context: *anyopaque, input: server.BodyEvent) !server.BodyEventResult {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        const identity = switch (input) {
+            inline else => |value| .{ value.stream_id, value.stream_index },
+        };
+        const slot = &self.driver.slots[identity[1]];
+        var response = self.make_response(identity[0]);
+        return self.driver.event(input, &response, .{ .context = slot, .resume_fn = resume_control, .cancel_fn = cancel_control });
+    }
+    fn resume_control(context: *anyopaque) error{BodyDeliveryFailed}!void {
+        const slot: *Driver.Slot = @ptrCast(@alignCast(context));
+        const self: *Fixture = @ptrCast(@alignCast(slot.owner.context));
+        self.session.resume_body(slot.stream_id, self.callbacks()) catch return error.BodyDeliveryFailed;
+    }
+    fn cancel_control(context: *anyopaque) void {
+        const slot: *Driver.Slot = @ptrCast(@alignCast(context));
+        const self: *Fixture = @ptrCast(@alignCast(slot.owner.context));
+        self.session.cancel_body(slot.stream_id, .cancelled, self.callbacks()) catch {
+            self.control_failure = true;
+        };
+    }
+    fn write(context: *anyopaque, parts: []const []const u8) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        var total: usize = 0;
+        for (parts) |part| total += part.len;
+        if (total > self.output.len - self.output_length) return error.WouldBlock;
+        for (parts) |part| {
+            @memcpy(self.output[self.output_length..][0..part.len], part);
+            self.output_length += part.len;
+        }
+    }
+    fn legacy_header(context: *anyopaque, _: *const Request) server.HeaderDecision {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        return if (self.legacy_refusal) .refuse_body else .buffered;
+    }
+    fn closed(context: *anyopaque, _: u32, _: u16) void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        self.closed_calls += 1;
+    }
+    fn buffered(context: *anyopaque, request: *Request, stream_id: u32) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        self.buffered_calls += 1;
+        self.buffered_bytes += request.body.len;
+        switch (self.buffered_action) {
+            .none => return,
+            .reset_error => try self.session.reset_stream(stream_id, .cancel, self.callbacks()),
+            .response_error => try self.session.send_response(stream_id, "204 No Content", "", "", self.callbacks()),
+        }
+        return error.ApplicationRequestFailed;
+    }
+    fn make_response(self: *Fixture, stream_id: u32) Response {
+        return .{ .target = .{ .http2 = .{ .context = self, .router = &self.router, .stream_id = stream_id, .end_fn = response_end, .begin_fn = response_begin, .write_fn = response_write, .finish_fn = response_finish } } };
+    }
+    fn response_end(context: *anyopaque, id: u32, status: []const u8, headers: []const u8, bytes: []const u8) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        try self.session.send_response(id, status, headers, bytes, self.callbacks());
+    }
+    fn response_begin(context: *anyopaque, id: u32, status: []const u8, headers: []const u8) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        try self.session.begin_response(id, status, headers, self.callbacks());
+    }
+    fn response_write(context: *anyopaque, id: u32, bytes: []const u8) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        try self.session.write_response_data(id, bytes, self.callbacks());
+    }
+    fn response_finish(context: *anyopaque, id: u32) !void {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        try self.session.finish_response(id, self.callbacks());
+    }
+    fn begin(context: *anyopaque, request: *const StreamingRequest, control: body.BodyControl) !body.BodyBinding {
+        const self: *Fixture = @ptrCast(@alignCast(context));
+        const slot: *Driver.Slot = @fieldParentPtr("body", control.owner);
+        self.begins += 1;
+        const binding = &self.bindings[slot.index];
+        binding.* = .{ .fixture = self, .control = control, .stream_id = slot.stream_id };
+        if (self.reset_during == .begin) {
+            try self.session.reset_stream(slot.stream_id, .cancel, self.callbacks());
+            self.metadata_ok = self.metadata_ok and std.mem.startsWith(u8, request.path, "/upload/");
+        }
+        if (self.fail_begin) return error.ApplicationBeginFailed;
+        return .{ .context = binding, .readiness = if (self.pause_begin) .paused else .ready };
+    }
+    fn chunk(context: *anyopaque, bytes: []const u8) !body.BodyProgress {
+        const binding: *Binding = @ptrCast(@alignCast(context));
+        const self = binding.fixture;
+        binding.chunks += 1;
+        if (self.reset_during == .chunk) {
+            try self.session.reset_stream(binding.stream_id, .cancel, self.callbacks());
+            self.metadata_ok = self.metadata_ok and std.mem.startsWith(u8, self.session.requests[0].path, "/upload/");
+        }
+        if (self.fail_chunk) return error.ApplicationChunkFailed;
+        const consumed = @min(self.pause_prefix orelse bytes.len, bytes.len);
+        @memcpy(binding.bytes[binding.length..][0..consumed], bytes[0..consumed]);
+        binding.length += consumed;
+        const paused = self.pause_prefix != null;
+        self.pause_prefix = null;
+        return .{ .consumed = consumed, .readiness = if (paused) .paused else .ready };
+    }
+    fn end(context: *anyopaque, request: *const StreamingRequest, response_value: *Response) !void {
+        const binding: *Binding = @ptrCast(@alignCast(context));
+        const self = binding.fixture;
+        binding.ends += 1;
+        try std.testing.expectError(error.BodyControlExpired, binding.control.cancel());
+        const slot: *Driver.Slot = @fieldParentPtr("body", binding.control.owner);
+        try std.testing.expectEqual(self.expected_active_in_end, self.router.body.active[slot.record_index]);
+        self.metadata_ok = self.metadata_ok and request.params.get("name") != null;
+        if (self.fail_end) return error.ApplicationEndFailed;
+        if (self.reset_during == .end) {
+            try self.session.reset_stream(binding.stream_id, .cancel, self.callbacks());
+            self.metadata_ok = self.metadata_ok and request.params.get("name") != null;
+            return;
+        }
+        try response_value.end("200 OK", "ok");
+        self.metadata_ok = self.metadata_ok and std.mem.startsWith(u8, request.path, "/upload/");
+    }
+    fn cancel(context: *anyopaque, reason: body.BodyCancelReason) void {
+        const binding: *Binding = @ptrCast(@alignCast(context));
+        binding.cancels += 1;
+        binding.reason = reason;
+        const slot: *Driver.Slot = @fieldParentPtr("body", binding.control.owner);
+        if (binding.fixture.router.body.active[slot.record_index] == 0) binding.fixture.control_failure = true;
+        if (binding.fixture.reset_during == .cancel) {
+            binding.fixture.session.reset_stream(binding.stream_id, .cancel, binding.fixture.callbacks()) catch {
+                binding.fixture.control_failure = true;
+            };
+        }
+        binding.control.cancel() catch |err| {
+            if (err != error.BodyControlExpired) binding.fixture.control_failure = true;
+            return;
+        };
+        binding.fixture.control_failure = true;
+    }
+    fn frame(self: *Fixture, kind: wire.FrameType, flags: u8, id: u32, payload: []const u8) !void {
+        var bytes: [16393]u8 = undefined;
+        try (wire.FrameHeader{ .payload_length = @intCast(payload.len), .frame_type = @intFromEnum(kind), .flags = flags, .stream_id = id }).encode(bytes[0..9]);
+        @memcpy(bytes[9..][0..payload.len], payload);
+        try self.session.receive(bytes[0 .. 9 + payload.len], self.callbacks());
+    }
+    fn head(self: *Fixture, id: u32, length: ?[]const u8, expect: bool, end_stream: bool) !void {
+        try self.head_path(id, "/upload/first", length, expect, end_stream);
+    }
+    fn head_path(self: *Fixture, id: u32, path: []const u8, length: ?[]const u8, expect: bool, end_stream: bool) !void {
+        var bytes: [512]u8 = undefined;
+        var used: usize = 0;
+        try literal(&bytes, &used, ":method", "POST");
+        try literal(&bytes, &used, ":scheme", "http");
+        try literal(&bytes, &used, ":path", path);
+        try literal(&bytes, &used, "x-initial", "retained");
+        if (length) |value| try literal(&bytes, &used, "content-length", value);
+        if (expect) try literal(&bytes, &used, "expect", "100-continue");
+        try self.frame(.headers, if (end_stream) 5 else 4, id, bytes[0..used]);
+    }
+    /// Fill the actual writer with accepted PING/SETTINGS acknowledgements.
+    fn fill_output(self: *Fixture, remaining: usize) !void {
+        self.output_length = 0;
+        const used = self.output.len - remaining;
+        for (0..18) |settings| {
+            if (settings * 9 > used or (used - settings * 9) % 17 != 0) continue;
+            for (0..settings) |_| try self.frame(.settings, 0, 0, "");
+            for (0..(used - settings * 9) / 17) |_| try self.frame(.ping, 0, 0, "12345678");
+            try std.testing.expectEqual(used, self.output_length);
+            return;
+        }
+        return error.UnrepresentableFill;
+    }
+    fn flush(self: *Fixture) !void {
+        self.output_length = 0;
+        try self.session.flush_pending(self.callbacks());
+    }
+};
+
+fn literal(output: []u8, used: *usize, name: []const u8, value: []const u8) !void {
+    if (name.len > 126 or value.len > 126 or 3 + name.len + value.len > output.len - used.*) return error.OutputTooSmall;
+    output[used.*] = 0;
+    output[used.* + 1] = @intCast(name.len);
+    used.* += 2;
+    @memcpy(output[used.*..][0..name.len], name);
+    used.* += name.len;
+    output[used.*] = @intCast(value.len);
+    used.* += 1;
+    @memcpy(output[used.*..][0..value.len], value);
+    used.* += value.len;
+}
+
+fn frame_count(fixture: *const Fixture, kind: wire.FrameType, id: u32) !usize {
+    var cursor: usize = 0;
+    var count: usize = 0;
+    while (cursor < fixture.output_length) {
+        const header = try wire.FrameHeader.parse(fixture.output[cursor..][0..9]);
+        if (header.frame_type == @intFromEnum(kind) and header.stream_id == id) count += 1;
+        cursor += 9 + header.payload_length;
+    }
+    try std.testing.expectEqual(fixture.output_length, cursor);
+    return count;
+}
+
+fn expect_status(fixture: *const Fixture, stream_id: u32, ordinal: usize, expected: []const u8) !void {
+    var cursor: usize = 0;
+    var seen: usize = 0;
+    while (cursor < fixture.output_length) {
+        const header = try wire.FrameHeader.parse(fixture.output[cursor..][0..9]);
+        const payload = fixture.output[cursor + 9 ..][0..header.payload_length];
+        cursor += 9 + header.payload_length;
+        if (header.frame_type != @intFromEnum(wire.FrameType.headers) or header.stream_id != stream_id) continue;
+        if (seen != ordinal) {
+            seen += 1;
+            continue;
+        }
+        var table = try support.http2_hpack.DynamicTable.init(&.{}, &.{}, 0);
+        var decoder = support.http2_hpack.Decoder.init(&table, 4096);
+        var fields: [16]support.http2_hpack.Header = undefined;
+        var bytes: [4096]u8 = undefined;
+        const decoded = try decoder.decode_fields(payload, &fields, &bytes);
+        try std.testing.expectEqualStrings(":status", decoded[0].name);
+        try std.testing.expectEqualStrings(expected, decoded[0].value);
+        if (std.mem.eql(u8, expected, "100")) try std.testing.expectEqual(@as(u8, 0), header.flags & 1);
+        return;
+    }
+    return error.MissingResponseHeaders;
+}
+
+test "http2 upload: encoded Session reaches registered begin chunk end beyond buffered stride" {
+    var fixture = Fixture{};
+    try fixture.init();
+    try fixture.head(1, "100", false, false);
+    const bytes: [100]u8 = @splat('a');
+    try fixture.frame(.data, 1, 1, &bytes);
+    try std.testing.expectEqual(@as(usize, 1), fixture.begins);
+    try std.testing.expectEqual(@as(usize, 100), fixture.bindings[0].length);
+    try std.testing.expectEqualSlices(u8, &bytes, fixture.bindings[0].bytes[0..100]);
+    try std.testing.expectEqual(@as(usize, 1), fixture.bindings[0].ends);
+    try std.testing.expectEqual(@as(usize, 0), fixture.bindings[0].cancels);
+    try std.testing.expectEqual(@as(u16, 0), fixture.router.body.active[0]);
+    try std.testing.expect(fixture.metadata_ok);
+    try std.testing.expectEqual(@as(usize, 1), try frame_count(&fixture, .headers, 1));
+    try std.testing.expectEqual(@as(i64, 65535), fixture.session.connection.connection_receive_window);
+}
+
+test "http2 upload: partial pause retains FIFO observes fresh once and ends on public resume" {
+    var fixture = Fixture{ .pause_prefix = 2 };
+    try fixture.init();
+    try fixture.head(1, "10", false, false);
+    try fixture.frame(.data, 0, 1, "abcdef");
+    try fixture.frame(.data, 1, 1, "ghij");
+    try std.testing.expectEqual(@as(usize, 2), fixture.bindings[0].length);
+    try std.testing.expectEqual(@as(u64, 10), fixture.driver.slots[0].body.observed);
+    try std.testing.expectEqual(@as(usize, 0), fixture.bindings[0].ends);
+    try fixture.bindings[0].control.@"resume"();
+    try std.testing.expectEqualStrings("abcdefghij", fixture.bindings[0].bytes[0..10]);
+    try std.testing.expectEqual(@as(usize, 1), fixture.bindings[0].ends);
+    try std.testing.expectEqual(@as(i64, 65535), fixture.session.connection.connection_receive_window);
+}
+
+test "http2 upload: blocked Continue holds ready DATA and empty EOF until actual acceptance" {
+    var fixture = Fixture{};
+    try fixture.init();
+    try fixture.fill_output(0);
+    try fixture.head(1, "6", true, false);
+    try fixture.frame(.data, 0, 1, "abc");
+    try fixture.frame(.data, 1, 1, "def");
+    try std.testing.expectEqual(@as(usize, 0), fixture.bindings[0].chunks);
+    try std.testing.expectEqual(body.BodyReadiness.ready, fixture.driver.slots[0].body.readiness);
+    try std.testing.expect(!fixture.session.body_receive.?.paused[0]);
+    try std.testing.expectEqual(@as(u64, 6), fixture.driver.slots[0].body.observed);
+    try fixture.flush();
+    try std.testing.expectEqualStrings("abcdef", fixture.bindings[0].bytes[0..6]);
+    try std.testing.expectEqual(@as(usize, 1), fixture.bindings[0].ends);
+    try std.testing.expectEqual(@as(usize, 2), try frame_count(&fixture, .headers, 1));
+    try expect_status(&fixture, 1, 0, "100");
+    try expect_status(&fixture, 1, 1, "200");
+    var empty = Fixture{};
+    try empty.init();
