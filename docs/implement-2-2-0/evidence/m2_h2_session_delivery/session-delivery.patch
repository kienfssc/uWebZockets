+const StorageRange = struct { start: usize, length: usize, alignment: usize };
+
+fn storage_range(comptime T: type, values: []T) StorageRange {
+    return .{ .start = @intFromPtr(values.ptr), .length = values.len * @sizeOf(T), .alignment = @alignOf(T) };
+}
+
+fn check_storage_ranges(comptime S: type, storage: S.Storage, start: usize, length: usize, alignment_floor: usize) !void {
+    const state = storage.body_receive.?;
+    const ranges = [_]StorageRange{
+        storage_range(Request, storage.requests),
+        storage_range(u8, storage.request_storage),
+        storage_range(u8, storage.body_storage),
+        storage_range(u8, storage.response_header_storage),
+        storage_range(u8, storage.response_body_storage),
+        storage_range(support.http2_hpack.Header, storage.decoded_headers),
+        storage_range(u8, storage.decoded_header_bytes),
+        storage_range(support.http2_hpack.DynamicEntry, storage.dynamic_entries),
+        storage_range(u8, storage.dynamic_bytes),
+        storage_range(u8, storage.header_block),
+        storage_range(u8, storage.frame_buffer),
+        storage_range(support.http2_hpack.Header, storage.response_fields),
+        storage_range(u8, storage.response_encode),
+        storage_range(u8, storage.lowercase_names),
+        storage_range([]const u8, storage.header_extra_names),
+        storage_range([]const u8, storage.header_extra_values),
+        storage_range(S.ReceiveState, state[0..1]),
+        storage_range(u8, state.queue.storage.payload),
+        storage_range(support.http2_body_queue.Block, state.queue.storage.blocks),
+        storage_range(support.http2_body_queue.Stream, state.queue.storage.streams),
+    };
+    for (ranges, 0..) |range, index| {
+        if (range.length == 0) continue;
+        try std.testing.expectEqual(@as(usize, 0), range.start % @max(range.alignment, alignment_floor));
+        try std.testing.expect(range.start >= start and range.start + range.length <= start + length);
+        for (ranges[0..index]) |previous| {
+            if (previous.length == 0) continue;
+            try std.testing.expect(range.start + range.length <= previous.start or previous.start + previous.length <= range.start);
+        }
+    }
+}
