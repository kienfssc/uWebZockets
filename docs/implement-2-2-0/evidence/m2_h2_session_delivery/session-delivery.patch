+fn update_sum(fixture: *const Fixture, id: u32) !u32 {
+    var cursor: usize = 0;
+    var sum: u32 = 0;
+    while (cursor < fixture.output_length) {
+        const header = try wire.FrameHeader.parse(fixture.output[cursor..][0..9]);
+        if (header.frame_type == @intFromEnum(wire.FrameType.window_update) and header.stream_id == id)
+            sum += std.mem.readInt(u32, fixture.output[cursor + 9 ..][0..4], .big);
+        cursor += 9 + header.payload_length;
+    }
+    return sum;
+}
+
+fn expect_failure_headers(fixture: *const Fixture) !void {
+    var cursor: usize = 0;
+    while (cursor < fixture.output_length) {
+        const header = try wire.FrameHeader.parse(fixture.output[cursor..][0..9]);
+        const payload = fixture.output[cursor + 9 ..][0..header.payload_length];
+        cursor += 9 + header.payload_length;
+        if (header.frame_type != @intFromEnum(wire.FrameType.headers) or header.stream_id != 1) continue;
+        var table = try support.http2_hpack.DynamicTable.init(&.{}, &.{}, 0);
+        var decoder = support.http2_hpack.Decoder.init(&table, 4096);
+        var fields: [16]support.http2_hpack.Header = undefined;
+        var bytes: [4096]u8 = undefined;
+        const decoded = try decoder.decode_fields(payload, &fields, &bytes);
+        for (decoded) |field| {
+            if (!std.mem.eql(u8, field.name, "x-saved")) continue;
+            try std.testing.expectEqualStrings("middleware", field.value);
+            return;
+        }
+        return error.MissingSavedMiddleware;
+    }
+    return error.MissingResponseHeaders;
+}
