+        fixture.definition.limits.max_body_bytes = 70000;
+        try fixture.head(1, null, false, false);
+        fixture.pause_begin = false;
+        try fixture.head(3, "1", false, false);
+        const payload: [16384]u8 = @splat('a');
+        var remaining: usize = 65535;
+        while (remaining != 0) {
+            const count = @min(remaining, payload.len);
+            try fixture.frame(.data, 0, 1, payload[0..count]);
+            remaining -= count;
+        }
+        try std.testing.expectEqual(@as(i64, 0), fixture.session.connection.connection_receive_window);
+        if (blocked) try fixture.fill_output(0);
+        try fixture.frame(.rst_stream, 0, 1, "\x00\x00\x00\x08");
+        if (blocked) {
+            try std.testing.expectEqual(@as(u32, 65535), fixture.session.body_receive.?.connection_pending);
+            try std.testing.expectEqual(@as(i64, 0), fixture.session.connection.connection_receive_window);
+            try fixture.flush();
+        }
+        try std.testing.expectEqual(@as(i64, 65535), fixture.session.connection.connection_receive_window);
+        try std.testing.expectEqual(@as(u32, 65535), try update_sum(&fixture, 0));
+        try std.testing.expectEqual(@as(usize, 0), try frame_count(&fixture, .window_update, 1));
+        try std.testing.expectEqual(@as(usize, 1), fixture.bindings[0].cancels);
+        try fixture.frame(.data, 1, 3, "z");
+        try std.testing.expectEqual(@as(usize, 1), fixture.bindings[1].ends);
+        try std.testing.expectEqualStrings("z", fixture.bindings[1].bytes[0..1]);
+        try std.testing.expectEqual(@as(u32, 65536), try update_sum(&fixture, 0));
+        try fixture.flush();
+        try std.testing.expectEqual(@as(u32, 0), try update_sum(&fixture, 0));
+    }
