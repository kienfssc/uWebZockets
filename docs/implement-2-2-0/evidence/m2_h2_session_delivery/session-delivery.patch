+
+const SelectedContext = struct {
+    output: Context = .{ .refuse = false },
+    declared: ?u64 = null,
+    heads: usize = 0,
+    ends: usize = 0,
+    closes: usize = 0,
+
+    fn write(context: *anyopaque, parts: []const []const u8) !void {
+        const state: *SelectedContext = @ptrCast(@alignCast(context));
+        try Context.write(&state.output, parts);
+    }
+
+    fn request(_: *anyopaque, _: *support.http_request.Request, _: u32) !void {
+        return error.UnexpectedBufferedDispatch;
+    }
+
+    fn select(_: *anyopaque, _: *const support.http_request.Request) bool {
+        return true;
+    }
+
+    fn event(context: *anyopaque, input: server.BodyEvent) !server.BodyEventResult {
+        const state: *SelectedContext = @ptrCast(@alignCast(context));
+        switch (input) {
+            .head => |head| {
+                state.heads += 1;
+                state.declared = head.declared;
+                return .{ .head = .{ .accepted = .paused } };
+            },
+            .data => return error.UnexpectedBodyData,
+            .end => state.ends += 1,
+            .closed => state.closes += 1,
+        }
+        return .done;
+    }
+};
+
+test "body H2: selected encoded Session preserves full u64 declaration without claiming EOF" {
+    const lengths = [_][]const u8{ "4294967296", "18446744073709551615" };
+    for (lengths) |length_text| {
+        var bundle = Session.Bundle(.{ .body_size = 32, .stream_request_bodies = true }){};
+        var session = try Session.init(bundle.storage());
+        var state = SelectedContext{};
+        const callbacks = server.Callbacks{ .context = &state, .write_fn = SelectedContext.write, .request_fn = SelectedContext.request, .body_select_fn = SelectedContext.select, .body_event_fn = SelectedContext.event };
+        try session.receive(http2.client_preface, callbacks);
+        try frame(&session, .settings, 0, 0, "", callbacks);
+        state.output.length = 0;
+        var block: [256]u8 = undefined;
+        var length: usize = 0;
+        try literal(&block, &length, ":method", "POST");
+        try literal(&block, &length, ":scheme", "https");
+        try literal(&block, &length, ":path", "/upload");
+        try literal(&block, &length, "content-length", length_text);
+        try frame(&session, .headers, 4, 1, block[0..length], callbacks);
+        try std.testing.expectEqual(@as(usize, 1), state.heads);
+        try std.testing.expectEqual(try std.fmt.parseInt(u64, length_text, 10), state.declared.?);
+        try std.testing.expect(session.expected_content_lengths[0] == null);
+        try std.testing.expectEqual(@as(usize, 0), state.ends);
+        try std.testing.expectEqual(@as(usize, 0), state.output.length);
+        try std.testing.expect(session.connection.streams.find(1) != null);
+        try session.cancel_body(1, .cancelled, callbacks);
+        try std.testing.expectEqual(@as(usize, 1), state.closes);
+        try std.testing.expectEqual(@as(usize, 0), state.ends);
+        try std.testing.expect(!session.closed);
+    }
+}
