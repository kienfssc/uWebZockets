+test "fix1 F4: admitted overflow keeps middleware and final reset FIFO under output pressure" {
+    inline for (.{ false, true }) |blocked| {
+        var fixture = Fixture{ .pause_begin = true };
+        try fixture.init();
+        fixture.definition.limits.max_body_bytes = 3;
