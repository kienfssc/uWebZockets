+fn check_bundle_carve(comptime count: usize, comptime nonaligned: bool) !void {
+    const S = server.server_session(count);
+    const caps = S.Capacities{
+        .stream_request_bodies = true,
+        .header_block_size = if (nonaligned) 257 else 512,
+        .request_header_size = if (nonaligned) 4097 else 4096,
+        .body_size = if (nonaligned) 17 else 16,
+        .response_header_size = if (nonaligned) 2049 else 2048,
+        .response_header_count = 33,
+        .decoded_header_count = 65,
+        .dynamic_table_size = if (nonaligned) 1025 else 1024,
+    };
+    const bytes = comptime try S.storage_bytes(caps);
+    var region: [bytes + S.storage_alignment]u8 align(S.storage_alignment) = undefined;
+    const aligned = try S.carve_storage(region[0..bytes], caps);
+    try check_storage_ranges(S, aligned, @intFromPtr(&region), bytes, 1);
+    const unaligned = try S.carve_storage(region[1..], caps);
+    try check_storage_ranges(S, unaligned, @intFromPtr(region[1..].ptr), region.len - 1, 1);
+    var bundle = S.Bundle(caps){};
+    const storage = bundle.storage();
+    try check_storage_ranges(S, storage, @intFromPtr(&bundle), @sizeOf(@TypeOf(bundle)), S.storage_alignment);
+    _ = try S.init(storage);
