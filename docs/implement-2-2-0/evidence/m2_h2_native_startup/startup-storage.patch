diff --git a/src/tests/config_tests.zig b/src/tests/config_tests.zig
--- a/src/tests/config_tests.zig
+++ b/src/tests/config_tests.zig
@@ -23,0 +24,84 @@
+}
+
+test "config: H2 streaming capacity follows startup policy" {
+    const disabled = ServerConfig{};
+    const enabled = ServerConfig{ .stream_request_bodies = true };
+    try std.testing.expect(!disabled.h2_capacities().stream_request_bodies);
+    try std.testing.expect(enabled.h2_capacities().stream_request_bodies);
+}
+
+test "config: H2 upload storage is bounded and independent of body stride" {
+    if (support.loop.require_request_streaming_setup(true)) |_| {} else |_| return error.SkipZigTest;
+    for ([_]usize{ 1, 8192 }) |body_size| {
+        const config = ServerConfig{ .max_connections = 2, .max_route_params = 20, .max_h2_body_size = body_size, .stream_request_bodies = true };
+        const total = try config_module.required_bytes(config);
+        const backing = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(config_module.slab_alignment), total + config_module.slab_alignment);
+        defer std.testing.allocator.free(backing);
+        const slab = backing[0..total];
+        try std.testing.expectError(error.SlabTooSmall, config_module.carve(slab[0 .. total - 1], config));
+        try std.testing.expectError(error.MisalignedSlab, config_module.carve(backing[1..][0..total], config));
+        const layout = try config_module.carve(slab, config);
+        try std.testing.expectEqual(@as(usize, 2), layout.h2_upload_owners.len);
+        try std.testing.expectEqual(@as(usize, 2 * 8 * 4), layout.h2_capture_names.len);
+        try std.testing.expectEqual(layout.h2_capture_names.len, layout.h2_capture_values.len);
+        const owners = std.mem.sliceAsBytes(layout.h2_upload_owners);
+        const names = std.mem.sliceAsBytes(layout.h2_capture_names);
+        const values = std.mem.sliceAsBytes(layout.h2_capture_values);
+        const start = @intFromPtr(slab.ptr);
+        const regions = [_][]u8{
+            std.mem.sliceAsBytes(layout.pool_storage),       std.mem.sliceAsBytes(layout.freelist),
+            layout.request_buffers,                          layout.header_extras,
+            layout.route_param_extras,                       layout.h2_sessions,
+            layout.write_queues,                             layout.ws_messages,
+            layout.compression_scratch,                      std.mem.sliceAsBytes(layout.datagram_session_ids),
+            std.mem.sliceAsBytes(layout.datagram_sequences), std.mem.sliceAsBytes(layout.datagram_payload_lengths),
+            std.mem.sliceAsBytes(layout.datagram_rings),     layout.datagram_payloads,
+            layout.xdp_umem,                                 layout.xdp_transport_bytes,
+            std.mem.sliceAsBytes(layout.upload_owners),      owners,
+            names,                                           values,
+            layout.router_storage,
+        };
+        try std.testing.expect(layout.metrics_registry == null);
+        for (regions, 0..) |region, i| {
+            if (region.len == 0) continue;
+            const region_start = @intFromPtr(region.ptr);
+            try std.testing.expect(region_start >= start);
+            try std.testing.expect(region_start + region.len <= start + total);
+            for (regions[i + 1 ..]) |other| {
+                if (other.len == 0) continue;
+                const other_start = @intFromPtr(other.ptr);
+                try std.testing.expect(region_start + region.len <= other_start or other_start + other.len <= region_start);
+            }
+        }
+        try std.testing.expect(@intFromPtr(owners.ptr) >= start);
+        try std.testing.expect(@intFromPtr(owners.ptr) + owners.len <= @intFromPtr(names.ptr));
+        try std.testing.expect(@intFromPtr(names.ptr) + names.len <= @intFromPtr(values.ptr));
+        try std.testing.expect(@intFromPtr(values.ptr) + values.len <= @intFromPtr(layout.router_storage.ptr));
+        try std.testing.expect(@intFromPtr(layout.router_storage.ptr) + layout.router_storage.len <= start + total);
+        try std.testing.expectEqual(@as(usize, 0), @intFromPtr(owners.ptr) % @alignOf(@TypeOf(layout.h2_upload_owners[0])));
+        try std.testing.expectEqual(@as(usize, 0), @intFromPtr(names.ptr) % @alignOf([]const u8));
+        try std.testing.expectEqual(@as(usize, 0), @intFromPtr(values.ptr) % @alignOf([]const u8));
+        for (0..2) |connection| {
+            for (0..8) |stream| {
+                const offset = (connection * 8 + stream) * 4;
+                layout.h2_capture_names[offset] = "name";
+                layout.h2_capture_values[offset] = "value";
+                try std.testing.expectEqualStrings("name", layout.h2_capture_names[offset]);
+                try std.testing.expectEqualStrings("value", layout.h2_capture_values[offset]);
+            }
+        }
+        for (0..2) |index| {
+            const offset = index * layout.h2_session_stride;
+            const storage = try support.tcp.Http2Session.carve_storage(layout.h2_sessions[offset..][0..layout.h2_session_stride], config.h2_capacities());
+            try std.testing.expect(storage.body_receive != null);
+            try std.testing.expectEqual(body_size * 8, storage.body_storage.len);
+        }
+    }
+    const disabled = ServerConfig{ .max_connections = 2 };
+    const size = try config_module.required_bytes(disabled);
+    const slab = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(config_module.slab_alignment), size);
+    defer std.testing.allocator.free(slab);
+    const layout = try config_module.carve(slab, disabled);
+    try std.testing.expectEqual(@as(usize, 0), layout.h2_upload_owners.len);
+    try std.testing.expectEqual(@as(usize, 0), layout.h2_capture_names.len);
+    try std.testing.expectEqual(@as(usize, 0), layout.h2_capture_values.len);
